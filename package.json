{
  "name": "favicon-motion",
  "version": "0.1.0",
  "description": "A lightweight, canvas-powered animated favicon library. Draw procedurally, or animate from frames, sprite sheets, video, Lottie, or dotLottie — no animated SVG, no bloated core.",
  "type": "module",
  "main": "./dist/favicon-motion.cjs.js",
  "module": "./dist/favicon-motion.esm.js",
  "unpkg": "./dist/favicon-motion.umd.js",
  "exports": {
    ".": {
      "import": "./dist/favicon-motion.esm.js",
      "require": "./dist/favicon-motion.cjs.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite demo --open",
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "favicon",
    "canvas",
    "animation",
    "animated-favicon",
    "browser",
    "gsap-like",
    "video",
    "lottie",
    "dotlottie"
  ],
  "license": "MIT",
  "devDependencies": {
    "@lottiefiles/dotlottie-web": "^0.78.2",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.9.0",
    "jsdom": "^29.1.1",
    "lottie-web": "^5.13.0",
    "rollup": "^4.20.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "lottie-web": "^5.12.0",
    "@lottiefiles/dotlottie-web": "^0.78.0"
  },
  "peerDependenciesMeta": {
    "lottie-web": {
      "optional": true
    },
    "@lottiefiles/dotlottie-web": {
      "optional": true
    }
  }
}
